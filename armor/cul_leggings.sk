function itemCulLeggings() :: item:
    set {_i} to unbreakable netherite leggings named "<#fcd05c>C<#f5c955>u<#edc14e>l <#dfb33f>L<#d7ab38>e<#d0a431>g<#c89c2a>g<#c19523>i<#ba8e1b>n<#b28614>g<#ab7f0d>s"

    set {_l::1} to "&8&omix their soul with your flame"
    set {_l::2} to "%nl%<#fcd05c>ʙᴜʀɴɪɴɢ ᴘᴀssɪᴏɴ"
    set {_l::3} to "&8🕘 -s <#fcd05c>• ᴘᴀssɪᴠᴇ"
    set {_l::4} to "&7Every 10 critical hits you apply a stack of &fBurning&7 to &fthe victim &7for &f15 seconds%nl%&7Maxes out at &fBurning III"

    set boolean tag "cul_leggings" of custom nbt of {_i} to true

    set armor trim of {_i} to armor trim from copper_material and silence_pattern

    set lore of {_i} to {_l::*}

    return {_i} with item flag hide enchants and hide armor trim

on damage:
    if boolean tag "cul_leggings" of custom nbt of attacker's leggings is true:
        if int tag "cul_leggingsCount" of custom nbt of attacker is 10:
            if {statusEffect::burning::%uuid of victim%} is 3:
                stop
            else:
                add 1 to {statusEffect::burning::%uuid of victim%}
import:
    org.bukkit.potion.PotionEffectType

every 10 ticks:
    loop all players:
        if {statusEffect::burning::%uuid of loop-player%} is set:
            set {_dmg} to 0.5 * {statusEffect::burning::%uuid of loop-player%}

            if loop-player.hasPotionEffect(PotionEffectType.FIRE_RESISTANCE):
                stop

            set {_epf} to 0

            add (level of fire protection on helmet of loop-player * 2) to {_epf}
            add (level of fire protection on chestplate of loop-player * 2) to {_epf}
            add (level of fire protection on leggings of loop-player * 2) to {_epf}
            add (level of fire protection on boots of loop-player * 2) to {_epf}

            # Cap at vanilla's maximum EPF contribution (20)
            if {_epf} > 20:
                set {_epf} to 20

            # 4% reduction per EPF (up to 80%)
            set {_dmg} to {_dmg} * (1 - ({_epf} * 0.04))

            damage loop-player by {_dmg}

every 5 tick:
    loop all players:
        if {statusEffect::burning::%uuid of loop-player%} is set:
            set {_level} to {statusEffect::burning::%uuid of loop-player%}

            # Flame
            loop ({_level} * 3) times:
                set {_loc} to location of loop-player
                add random number between 0.1 and 1.8 to y-coordinate of {_loc}
                add random number between -0.35 and 0.35 to x-coordinate of {_loc}
                add random number between -0.35 and 0.35 to z-coordinate of {_loc}
                draw flame particle at {_loc}

            # Smoke
            loop max(1, {_level}) times:
                set {_loc} to location of loop-player
                add random number between 0.6 and 2.0 to y-coordinate of {_loc}
                add random number between -0.3 and 0.3 to x-coordinate of {_loc}
                add random number between -0.3 and 0.3 to z-coordinate of {_loc}
                draw smoke particle at {_loc}

            # Campfire smoke (higher levels)
            if {_level} >= 3:
                loop floor({_level} / 2) times:
                    set {_loc} to location of loop-player
                    add random number between 1.2 and 2.2 to y-coordinate of {_loc}
                    add random number between -0.25 and 0.25 to x-coordinate of {_loc}
                    add random number between -0.25 and 0.25 to z-coordinate of {_loc}
                    draw campfire_cosy_smoke particle at {_loc}

            # Lava embers
            if {_level} >= 4:
                loop floor({_level} / 2) times:
                    set {_loc} to location of loop-player
                    add random number between 0.2 and 1.6 to y-coordinate of {_loc}
                    add random number between -0.2 and 0.2 to x-coordinate of {_loc}
                    add random number between -0.2 and 0.2 to z-coordinate of {_loc}
                    draw lava particle at {_loc}

            # Ash for very high levels
            if {_level} >= 6:
                loop floor({_level} / 2) times:
                    set {_loc} to location of loop-player
                    add random number between 0.5 and 2.0 to y-coordinate of {_loc}
                    add random number between -0.35 and 0.35 to x-coordinate of {_loc}
                    add random number between -0.35 and 0.35 to z-coordinate of {_loc}
                    draw ash particle at {_loc}