command /spawnaltar <text>:
    permission: op
    trigger:
        if {registeredAltars::*} contains arg-1:
            spawnAltar(arg-1, player)
        else:
            send "&cUnknown altar type: %arg-1%" to player

command /deletealtar <text>:
    permission: op
    trigger:
        if {registeredAltars::*} contains arg-1:
            deleteAltar(arg-1, player)
        else:
            send "&cUnknown altar type: %arg-1%" to player

on tab complete for "/spawnaltar":
    set tab completion for position 1 to {registeredAltars::*}

on tab complete for "/deletealtar":
    set tab completion for position 1 to {registeredAltars::*}

command /debugaltar:
    permission: op
    trigger:
        send "&eRegistered: %{registeredAltars::*}%"
        send "&eShard Config: %{altarConfig.shard_shooter.name}%"
        send "&eShard Location: %{altar.shard_shooter}%"