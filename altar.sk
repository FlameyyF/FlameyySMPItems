
function registerAltar(id: text, displayName: text, item: item, lines: strings):
    if {_id} is not in {registeredAltars::*}:
        add {_id} to {registeredAltars::*}

    set {altarConfig.%{_id}%.name} to {_displayName}
    set {altarConfig.%{_id}%.item} to {_item}
    delete {altarConfig.%{_id}%.lines::*}
    set {altarConfig.%{_id}%.lines::*} to {_lines::*}

function spawnAltar(id: text, p: player):
    if {altar.%{_id}%} is not set:
        set block at location of {_p} to reinforced deepslate
        set {_loc} to location of block at location of {_p}
        set {altar.%{_id}%} to {_loc}
        set yaw of {_loc} to 0
        set pitch of {_loc} to 0

        set {_itemLoc} to {_loc} ~ vector(0, 1.3, 0)
        spawn item display at {_itemLoc}
        set {_display} to last spawned item display
        set item of {_display} to {altarConfig.%{_id}%.item}
        set display scale of {_display} to vector(1, 1, 1)
        set {altar.%{_id}%.display} to {_display}

        set {_lines::*} to {altarConfig.%{_id}%.lines::*}
        set {_textLoc} to {_loc} ~ vector(0, 2.1, 0)
        loop {_lines::*}:
            spawn text display at {_textLoc}
            set {_text} to last spawned text display
            add {_text} to {altar.%{_id}%.entities::*}
            set text of {_text} to loop-value
            set billboard of {_text} to center
            set {_textLoc} to {_textLoc} ~ vector(0, 0.25, 0)

        send "&aThe %{altarConfig.%{_id}%.name}% Altar has been spawned." to {_p}
    else:
        send "&cThe %{altarConfig.%{_id}%.name}% Altar is already set, please use /deletealtar %{_id}%" to {_p}

function deleteAltar(id: text, p: player):
    if {altar.%{_id}%} is set:
        delete {altar.%{_id}%.used}

        set {_loc} to {altar.%{_id}%}
        set block at {_loc} to air

        if {altar.%{_id}%.display} is set:
            kill {altar.%{_id}%.display}
            delete {altar.%{_id}%.display}

        loop {altar.%{_id}%.entities::*}:
            if loop-value is set:
                kill loop-value
        delete {altar.%{_id}%.entities::*}

        delete {altar.%{_id}%}

        send "&cThe %{altarConfig.%{_id}%.name}% Altar has been deleted." to {_p}
    else:
        send "&cThe %{altarConfig.%{_id}%.name}% Altar is not set." to {_p}

